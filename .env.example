# Copy to .env and fill in. .env is gitignored — never commit real keys.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vision model used by all agents. Sonnet is most accurate; Haiku is ~3x cheaper
# and fine for classification/extraction if you want to conserve credits:
#   CLASSIFIER_MODEL=claude-haiku-4-5-20251001
CLASSIFIER_MODEL=claude-sonnet-5

# Optional observability — set LANGSMITH_TRACING=true to trace every agent's
# Claude call (tokens, latency, I/O) in LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_xxxxxxxxxxxxxxxxxxxxxxxx
LANGSMITH_PROJECT=medishield-intake
